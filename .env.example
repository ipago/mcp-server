# Public base URL of the iPago Developer API. The server calls it over HTTP
# with the API key from the caller's Authorization header. No key is stored here.
IPAGO_API_URL=https://api.ipago.io

# Documentation site used by the search_docs and get_doc_page tools.
DOCS_URL=https://docs.ipago.io

# Port the MCP HTTP server listens on.
PORT=3005

# Set to the string true to accept live keys (sk_live_ / rk_live_).
# Leave false so an assistant cannot move real money.
MCP_ALLOW_LIVE_KEYS=false
